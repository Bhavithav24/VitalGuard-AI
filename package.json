{
  "name": "vitalguard-ai-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "VitalGuard AI — clinical monitoring prototype with controlled real-time demo telemetry and backend-authoritative observation workflows",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --pretty false && vite build",
    "preview": "vite preview",
    "test": "vitest run src",
    "lint": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "smoke:api": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.61.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.13.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "@tailwindcss/postcss": "^4.3.3"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.6"
  }
